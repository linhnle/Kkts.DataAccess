<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Kkts.DataAccess.DependencyInjection</PackageId>
        <Description>Dependency injection registration, scoped resource management, and startup validation for Kkts.DataAccess protected reads.</Description>
        <PackageTags>data-access;authorization;dependency-injection;di;hosting;startup-validation</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Kkts.DataAccess/Kkts.DataAccess.csproj" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
