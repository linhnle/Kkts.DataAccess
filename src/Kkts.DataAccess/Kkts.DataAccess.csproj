<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Kkts.DataAccess</PackageId>
        <Description>Schema-controlled record- and field-level authorization for .NET data access, with provider-neutral protected read contracts.</Description>
        <PackageTags>data-access;authorization;access-control;row-level-security;field-level-security;policy;dotnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Kkts.DataAccess.Tests" />
        <None Include="README.md" Pack="true" PackagePath="/" />
        <PackageReference Include="Kkts.Expressions" Version="3.1.0" />
        <PackageReference Include="Kkts.Dynamic" Version="2.1.0" />
    </ItemGroup>
</Project>
